# Configuração do SAG-Cidadão no Docker (copie para .env.docker e preencha).
# Este modelo vai para o Git; o .env.docker com os valores reais, NUNCA.

# ---- Núcleo ----
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-por-uma-chave-aleatoria-de-50-caracteres
DEBUG=False
# Local: localhost. Servidor: o seu domínio, ex.: sag.exemplo.com.br,localhost
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8088
# Local sem certificado: False. Servidor com Caddy: True
HTTPS=False
# Local: 1 (só o Nginx). Servidor com Caddy na frente: 2
PROXIES_CONFIAVEIS=1
SITE_URL=http://localhost:8088
ADMIN_URL=admin/

# ---- Banco (o contêiner "db" é criado com estes dados) ----
DB_NAME=sag_cidadao
DB_USER=sag
# python -c "import secrets; print(secrets.token_urlsafe(24))"
DB_PASSWORD=troque-esta-senha

# ---- Porta do Nginx no seu computador / servidor ----
PORTA_PUBLICA=8088
# No servidor:
#PORTA_PUBLICA=127.0.0.1:8088

# ---- E-mail e alertas ----
#EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#EMAIL_HOST=smtp.exemplo.com.br
#EMAIL_PORT=587
#EMAIL_HOST_USER=
#EMAIL_HOST_PASSWORD=
#DEFAULT_FROM_EMAIL=SAG-Cidadão <nao-responda@exemplo.com.br>
#ADMINS=voce@exemplo.com.br
