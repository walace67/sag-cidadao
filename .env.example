# Modelo do arquivo .env (copie: cp .env.example .env e preencha).
# Este arquivo VAI para o Git: nunca coloque valores reais aqui.

# ---- Núcleo ----
# Gere uma chave com:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=troque-por-uma-chave-aleatoria
# True só na sua máquina de desenvolvimento
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Produção, ex.: CSRF_TRUSTED_ORIGINS=https://sag.exemplo.gov.br
CSRF_TRUSTED_ORIGINS=
# Produção: troque por algo menos óbvio, ex.: painel-interno-7f3a/
ADMIN_URL=admin/

# Endereço público, usado nos links dos e-mails de aviso
SITE_URL=http://127.0.0.1:8000
# Verificação em duas etapas obrigatória para servidores e gestores
#EXIGIR_2FA_EQUIPE=True
# Fila de tarefas: em produção, o padrão é o banco (worker: manage.py db_worker)
#TASKS_BACKEND=django_tasks_db.DatabaseBackend

# ---- Banco (PostgreSQL) ----
DB_NAME=sag_cidadao
DB_USER=sag
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ---- Produção ----
# HTTPS=True exige certificado; padrão: o contrário de DEBUG
#HTTPS=True
# True somente atrás do Nginx (Gunicorn inacessível de fora)
#CONFIAR_PROXY=True
# Comece com 3600; depois de o HTTPS estar estável, 31536000 (1 ano)
#SECURE_HSTS_SECONDS=3600
# Sem Redis, a produção usa o próprio PostgreSQL (manage.py createcachetable)
#REDIS_URL=redis://127.0.0.1:6379/1
#STATIC_ROOT=/srv/sag_cidadao/staticfiles
#GUNICORN_BIND=unix:/run/sag-cidadao/gunicorn.sock
#GUNICORN_WORKERS=3

# ---- Login gov.br (OpenID Connect) ----
# Fornecidos pelo credenciamento da Prefeitura no Login Único
#GOVBR_CLIENT_ID=
#GOVBR_CLIENT_SECRET=
#GOVBR_AMBIENTE=homologacao
#GOVBR_REDIRECT_URI=https://sag.exemplo.gov.br/contas/govbr/retorno/

# ---- Alertas ----
# Quem recebe e-mail de erro 500 e do monitoramento (separe por vírgula)
#ADMINS=ti@exemplo.gov.br,plantao@exemplo.gov.br
#SERVER_EMAIL=SAG-Cidadão Alertas <alertas@exemplo.gov.br>

# ---- Fotos e mapa ----
#MEDIA_ROOT=/srv/sag_cidadao/media
# Em produção, atrás do Nginx: o Nginx entrega a foto já autorizada
#SERVIR_MIDIA_COM_NGINX=True
# Servidor de mapas (padrão: OpenStreetMap; uso intenso pede servidor próprio)
#MAPA_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
#MAPA_TILES_ORIGEM=https://tile.openstreetmap.org

# ---- E-mail ----
# Sem estas linhas, os e-mails aparecem no terminal (desenvolvimento).
#EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#EMAIL_HOST=smtp.exemplo.gov.br
#EMAIL_PORT=587
#EMAIL_HOST_USER=
#EMAIL_HOST_PASSWORD=
#EMAIL_USE_TLS=True
#DEFAULT_FROM_EMAIL=SAG-Cidadão <nao-responda@exemplo.gov.br>

# ---- Backup (deploy/backup/) ----
# Pasta dos backups: FORA do projeto (e, de preferência, em outro disco)
#BACKUP_DIR=~/backups_sag/postgres
# Arquivo com a senha da criptografia (AES-256). Guarde uma cópia dele
# FORA do servidor: sem ele, o backup criptografado não volta.
#BACKUP_SENHA_ARQUIVO=~/.config/sag/backup.senha
#BACKUP_MANTER_DIARIOS=7
#BACKUP_MANTER_SEMANAIS=4
#BACKUP_MANTER_MENSAIS=6
# Cópia fora da máquina (regra 3-2-1): HD externo ou servidor via SSH
#BACKUP_COPIA_EXTERNA=/media/walace/HD_BACKUP/sag
